<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>Editar usuario</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background: #f4f6f8;
            color: #222;
        }

        header {
            background: #1f2937;
            color: white;
            padding: 30px;
        }

        header h1 {
            margin: 0 0 10px;
        }

        header p {
            margin: 0;
        }

        main {
            max-width: 800px;
            margin: 0 auto;
            padding: 30px 20px;
        }

        .navigation {
            margin-bottom: 30px;
        }

        .button {
            display: inline-block;
            padding: 9px 14px;
            margin-right: 10px;
            margin-bottom: 10px;
            text-decoration: none;
            background: #e5e7eb;
            color: #222;
            border-radius: 5px;
        }

        .button:hover {
            background: #d1d5db;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 8px;
            border: 1px solid #ddd;
        }

        .field {
            margin-bottom: 20px;
        }

        .field label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
        }

        .field input,
        .field select {
            width: 100%;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 14px;
        }

        .submit-button {
            border: none;
            padding: 10px 16px;
            background: #e5e7eb;
            color: #222;
            border-radius: 5px;
            cursor: pointer;
            font-size: 14px;
        }

        .submit-button:hover {
            background: #d1d5db;
        }
    </style>
</head>

<body>

    <header>
        <h1>Editar usuario</h1>
        <p>Modificar los datos del usuario del sistema.</p>
    </header>

    <main>

        <div class="navigation">

            <a class="button" href="/users">
                ← Volver a usuarios
            </a>

        </div>

        <section class="card">

            <form
                action="/users/{{userDetail._id}}/edit"
                method="POST"
            >

                <div class="field">
                    <label for="firstName">
                        Nombre
                    </label>

                    <input
                        type="text"
                        id="firstName"
                        name="firstName"
                        value="{{userDetail.firstName}}"
                        required
                    >
                </div>

                <div class="field">
                    <label for="lastName">
                        Apellido
                    </label>

                    <input
                        type="text"
                        id="lastName"
                        name="lastName"
                        value="{{userDetail.lastName}}"
                        required
                    >
                </div>

                <div class="field">
                    <label for="email">
                        Email
                    </label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        value="{{userDetail.email}}"
                        required
                    >
                </div>

                <div class="field">
                    <label for="role">
                        Rol
                    </label>

                    <select
                        id="role"
                        name="role"
                        required
                    >
                        <option
                            value="admin"
                            {{#if (eq userDetail.role "admin")}}selected{{/if}}
                        >
                            Administrador
                        </option>

                        <option
                            value="supervisor"
                            {{#if (eq userDetail.role "supervisor")}}selected{{/if}}
                        >
                            Supervisor
                        </option>

                        <option
                            value="technician"
                            {{#if (eq userDetail.role "technician")}}selected{{/if}}
                        >
                            Técnico
                        </option>

                    </select>
                </div>

                <button
                    type="submit"
                    class="submit-button"
                >
                    Guardar cambios
                </button>

            </form>

        </section>

    </main>

</body>

</html>